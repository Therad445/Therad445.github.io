---
import type {CollectionEntry} from 'astro:content';
import {pick,url,type Lang} from '../data/site';
interface Props {lang:Lang; projects:CollectionEntry<'projects'>[]; heading?:'h2'|'h3'}
const {lang,projects,heading='h2'}=Astro.props;
const Heading=heading;
---
<ul class="post-list">{projects.map(p=><li class="post-preview"><article><Heading><a href={url(lang,`projects/${p.data.slug}`)}>{p.data.noteTitle||p.data.title}</a></Heading><div class="post-meta"><time datetime={p.data.date}>{new Date(p.data.date).toLocaleDateString(lang==='ru'?'ru-RU':'en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'})}</time><span>{pick(lang,'Заметка о проекте','Project note')}</span></div><p>{p.data.summary}</p></article></li>)}</ul>
