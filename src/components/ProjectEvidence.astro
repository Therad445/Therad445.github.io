---
import {pick,type Lang} from '../data/site';
interface Props{lang:Lang;slug:string}
const {lang,slug}=Astro.props;
const settings:Record<string,{folder:string;name:string;title:string;alt:string;caption:string}>={
 'nginx-log-analyzer':{folder:'nginx',name:'actual-report',title:pick(lang,'Результат настоящего запуска','Output from an actual run'),alt:pick(lang,'240 запросов: 195 ответов 200, 21 ответ 404 и 24 ответа 500.','240 requests: 195 responses with status 200, 21 with 404 and 24 with 500.'),caption:pick(lang,'Визуализация JSON, который сформировал Java-анализатор на 240 синтетических строках. Это оформление экспорта, а не снимок интерфейса. Средний размер ответа — 960 байт, p95 — 1408 байт.','A visualisation of JSON produced by the Java analyser from 240 synthetic log lines, not an application screenshot. Mean response size: 960 bytes; p95: 1,408 bytes.')},
 'sre-observability-platform':{folder:'sre',name:'observed-counters',title:pick(lang,'Наблюдение за заданным сбоем','Observing a controlled failure'),alt:pick(lang,'Реальные счётчики локального стенда: 30 HTTP-проб, 24 успеха, 6 ошибок 503.','Actual local testbed counters: 30 HTTP probes, 24 successes, 6 HTTP 503 errors.'),caption:pick(lang,'График построен по последовательным ответам экспортёра /metrics. Шесть HTTP 503 заданы намеренно: на этом участке счётчик успехов стоит на месте, а ошибок — растёт. Запущены Python prober, Prometheus и SLA exporter; Kubernetes в этой проверке не использовался.','Plotted from successive /metrics responses. Six HTTP 503s were deliberately introduced: successes stop increasing while the failure counter rises. Python prober, Prometheus and SLA exporter were running locally; Kubernetes was not used in this check.')},
 'cuda-rentsense-knn':{folder:'cuda',name:'source-flow',title:pick(lang,'Путь вычисления','The computation path'),alt:pick(lang,'CPU передаёт признаки на GPU; GPU считает расстояния; матрица возвращается на CPU, где выбираются k соседей.','The CPU sends features to the GPU; the GPU computes distances; the matrix returns to the CPU for k-neighbour selection.'),caption:pick(lang,'Схема сверена с исходниками. GPU считает расстояния, выбор соседей остаётся на CPU. Полная матрица float32 занимает 4QN байт на каждой стороне. Это схема реализации, а не результат измерения скорости.','Checked against the source. The GPU computes distances; neighbour selection remains on the CPU. The full float32 matrix occupies 4QN bytes on each side. This is an implementation diagram, not a performance measurement.')}
};
const e=settings[slug],base=`/data/project-demos/${e.folder}/${e.name}-${lang}`;
---
<section class="project-evidence" aria-labelledby="evidence-title">
<h2 id="evidence-title">{e.title}</h2>
<p class="article-date">{slug==='cuda-rentsense-knn'?pick(lang,'Сверено с кодом 10 ноября 2026 · без запуска GPU','Checked against source on 10 November 2026 · no GPU execution'):pick(lang,'Проверено 10 ноября 2026 · синтетические данные','Checked 10 November 2026 · synthetic data')}</p>
<figure><a href={`${base}.svg`} aria-label={pick(lang,'Открыть иллюстрацию в полном размере','Open the full-size figure')}><img class="chart-light" src={`${base}.svg`} width="1280" height={slug==='cuda-rentsense-knn'?1280:680} loading="lazy" alt={e.alt}/><img class="chart-dark" src={`${base}-dark.svg`} width="1280" height={slug==='cuda-rentsense-knn'?1280:680} loading="lazy" alt={e.alt}/></a><figcaption>{e.caption}</figcaption></figure>
{slug==='nginx-log-analyzer'&&<><div class="quiet-links"><a href="/data/project-demos/nginx/report.json">JSON</a><a href="/data/project-demos/nginx/report.csv">CSV</a><a href="/data/project-demos/nginx/report.md">Markdown</a><a href="/data/project-demos/nginx/synthetic-access.log">{pick(lang,'Исходный лог','Input log')}</a></div><details><summary>{pick(lang,'Оригинальный график приложения и обнаруженные ограничения','Original application chart and observed limitations')}</summary><figure><img src="/data/project-demos/nginx/traffic-original.png" width="1000" height="600" loading="lazy" alt={pick(lang,'Оригинальный график ChartGenerator с частотой запросов и долей ошибок.','Original ChartGenerator plot of request counts and error share.')}/><figcaption>{pick(lang,'Синяя линия — запросы за 20 секунд: в исходной легенде ошибочно написано reqs/min. Оранжевая линия — доля ошибок, выведенная на ту же шкалу. График сохранён без исправлений.','Blue: requests per 20 seconds; the original legend incorrectly says reqs/min. Orange: error share on the same axis. The chart is shown unchanged.')}</figcaption></figure><p>{pick(lang,'В этом наборе анализатор не отметил аномалии. PDF-экспорт получил дефект отображения кириллицы, поэтому здесь доступны JSON, CSV и Markdown. Нагрузочные тесты этим запуском не заменяются.','The analyser flagged no anomalies in this input. PDF export had a Cyrillic rendering defect, so JSON, CSV and Markdown are provided here. This run is not a load test.')}</p></details></>}
{slug==='sre-observability-platform'&&<><div class="quiet-links"><a href="/data/project-demos/sre/counter-samples.csv">CSV</a><a href="/data/project-demos/sre/prober-metrics.prom">{pick(lang,'Прямой экспорт метрик','Raw exporter metrics')}</a><a href="/data/project-demos/sre/prometheus-success.json">{pick(lang,'Ответ Prometheus','Prometheus response')}</a></div><p class="research-limit">{pick(lang,'Счётчики сняты в конце короткого запуска. Оконный расчёт increase() в Prometheus отличается от простой доли 24/30 из-за момента сбора и экстраполяции. Это демонстрация измерения, не показатель доступности рабочего сервиса.','Counters were captured at the end of a short run. Prometheus windowed increase() differs from the simple 24/30 share because of sampling and extrapolation. This demonstrates measurement, not production availability.')}</p></>}
{slug==='cuda-rentsense-knn'&&<p>{pick(lang,'Для графика ускорения ещё нужны запуск на GPU, прогрев, повторные замеры и проверка совпадения предсказаний. Одна серия без повторов не покажет разброс времени.','A speedup chart still needs GPU execution, warm-up, repeated timing and matching CPU/GPU predictions. A single unrepeated series does not measure timing variability.')}</p>}
<p class="quiet-links"><a href="/data/project-demos/PROTOCOL_RU.md">{pick(lang,'Условия запуска, версии и ограничения','Run conditions, versions and limitations (Russian)')}</a><a href="/data/project-demos/manifest.json">{pick(lang,'Версии исходного кода','Source versions')}</a></p>
</section>
