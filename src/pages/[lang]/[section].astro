---
import {getCollection} from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeading from '../../components/PageHeading.astro';
import Publications from '../../components/Publications.astro';
import PostList from '../../components/PostList.astro';
import {languages,sections,person,pick,url,research,education,books,type Lang} from '../../data/site';
export function getStaticPaths(){return languages.flatMap(lang=>sections.map(section=>({params:{lang,section:section.slug}})))}
const lang=Astro.params.lang as Lang;
const section=Astro.params.section!;
const projects=(await getCollection('projects',({data})=>data.lang===lang)).sort((a,b)=>a.data.order-b.data.order);
const labels:Record<string,{title:string;intro:string}>={
 about:{title:pick(lang,'Обо мне','About me'),intro:pick(lang,'Немного об учёбе, работе и интересах.','A little about my studies, work and interests.')},
 projects:{title:pick(lang,'Проекты','Projects'),intro:pick(lang,'Несколько моих учебных и самостоятельных работ. У каждой есть код и небольшая заметка о том, как она устроена.','A few of my course and personal projects. Each has source code and a short note explaining how it works.')},
 research:{title:pick(lang,'Исследования','Research'),intro:pick(lang,'Здесь собраны темы, которыми я занимаюсь, и опубликованные статьи. Текущие исследования пока не завершены.','These are the topics I’m working on, followed by my published articles. The current research is still in progress.')},
 writing:{title:pick(lang,'Заметки и статьи','Notes and articles'),intro:pick(lang,'Пока здесь в основном заметки о программировании и учебных проектах. Ниже — две статьи об анализе логов.','For now, most of these notes concern programming and course projects. Two published articles about log analysis follow below.')},
 library:{title:pick(lang,'Книги и другие интересы','Books and other interests'),intro:pick(lang,'Люблю классическую литературу, древнюю историю и языки. Ниже — несколько особенно близких мне книг.','I enjoy classical literature, ancient history and languages. Here are a few books that mean a lot to me.')},
 contact:{title:pick(lang,'Контакты','Contact'),intro:pick(lang,'Мне можно написать о работе, исследованиях или о чём-то из этого сайта.','You can get in touch about work, research or something you’ve read here.')},
};
const info=labels[section];
---
<Layout lang={lang} title={info.title} description={info.intro} path={section} type={section==='about'?'ProfilePage':'WebPage'}>
<PageHeading lang={lang} {...info}/>
<div class="page-content">
{section==='about'&&<>
<div class="prose">{person.bio[lang].map(p=><p>{p}</p>)}
<h2>{pick(lang,'Образование','Education')}</h2>
<ul class="education-list">{education.map(e=><li><strong>{e.label[lang]}</strong> — {e.text[lang]}<small>{e.period}</small></li>)}</ul>
<h2>{pick(lang,'С чем работаю','Tools I use')}</h2><p>{pick(lang,'В основном Java и Python. Из инфраструктурных инструментов — Linux, Docker, Kubernetes и Prometheus. В проектах есть Kafka, Flink и ClickHouse; в работах по ML — PyTorch и CUDA.','Mostly Java and Python. For infrastructure, I use Linux, Docker, Kubernetes and Prometheus. My projects also involve Kafka, Flink and ClickHouse; the ML work includes PyTorch and CUDA.')}</p>
<p>{pick(lang,'В 2025 году прошёл конкурс портфолио ИТМО по двум направлениям: «Распределённые веб-сервисы» и «DevOps-инженер облачных сервисов». Моё имя есть в','In 2025, I passed ITMO’s portfolio competition for Distributed Web Services and Cloud Services DevOps Engineer. My name appears in the')} <a href="https://www.ipkn.itmo.ru/portfolio2025-2volna">{pick(lang,'списке победителей второй волны','second-round list of winners')}</a>.</p>
</div></>}
{section==='projects'&&<ul class="post-list">{projects.map(p=><li class="post-preview"><article><h2><a href={url(lang,`projects/${p.data.slug}`)}>{p.data.title}</a></h2><p>{p.data.summary}</p><div class="project-tools">{p.data.tags.join(' · ')}<br/>{p.data.status}</div><p class="quiet-links"><a href={url(lang,`projects/${p.data.slug}`)}>{pick(lang,'О проекте','Read the note')}</a><a href={p.data.repo}>{pick(lang,'Код на GitHub','Code on GitHub')}</a></p></article></li>)}</ul>}
{section==='research'&&<>
{research.map(r=><section class="research-item" id={r.id}><h2>{r.title[lang]}</h2><p class="status">{r.status[lang]}</p><p>{r.text[lang]}</p><p>{r.method[lang]}</p><p class="research-limit">{r.limit[lang]}</p></section>)}
<section class="publications" id="publications"><h2>{pick(lang,'Опубликованные статьи','Published articles')}</h2><Publications lang={lang}/><p class="translation-note">{pick(lang,'Это журнальная статья и статья в сборнике. Статус рецензирования не подтверждён; название сборника не означает награду.','These are a journal article and a proceedings article. Peer-review status has not been verified; the proceedings title does not imply an award.')}</p></section>
<section class="publications"><h2>{pick(lang,'Учебный эксперимент по RL','An RL course experiment')}</h2><p><a href={url(lang,'projects/nstep-sac-reproducibility')}>n-step Soft Actor-Critic</a> — {pick(lang,'сравнение трёх горизонтов возврата. Код и результаты доступны, но на каждую конфигурацию приходится только один seed.','a comparison of three return horizons. Code and results are available, but there is only one seed per configuration.')}</p></section></>}
{section==='writing'&&<><PostList lang={lang} projects={[...projects].reverse()}/><section class="publications"><h2>{pick(lang,'Статьи, опубликованные в 2025 году','Articles published in 2025')}</h2><Publications lang={lang}/>{lang==='en'&&<p class="translation-note">Both articles are in Russian. Their titles are translated here for convenience.</p>}</section></>}
{section==='library'&&<><div class="prose"><p>{pick(lang,'Мне нравятся истории, в которых человек пытается сопротивляться своей судьбе — или тому, что он принимает за судьбу. Поэтому рядом в моём списке оказываются Шекспир, античные эпосы и Лавкрафт.','I like stories about people trying to resist their fate — or what they believe to be their fate. That is how Shakespeare, ancient epics and Lovecraft end up next to each other on my reading list.')}</p></div><ul class="book-list">{books.map(b=><li><h2>{b.title[lang]} <span class="book-author">/ {b.author[lang]}</span></h2><p>{b.note[lang]}</p></li>)}</ul><h2>{pick(lang,'Где веду списки','Where I keep my lists')}</h2><p>{pick(lang,'Книги отмечаю в','I track books on')} <a href="https://www.goodreads.com/therad445">Goodreads</a>, {pick(lang,'аниме и мангу — на','and anime and manga on')} <a href="https://shikimori.io/TheRad445">Shikimori</a>.</p><p>{pick(lang,'Ещё интересуюсь исторической письменностью. С этим связана моя работа по','I’m also interested in historical writing systems. This connects to my work on')} <a href={`${url(lang,'research')}#historical-ocr`}>{pick(lang,'распознаванию старых текстов','recognising old texts')}</a>.</p></>}
{section==='contact'&&<><ul class="contact-list"><li><a href={`mailto:${person.email}`}>{person.email}</a><small>{pick(lang,'Почта','Email')}</small></li><li><a href={person.telegram}>@Rad445</a><small>Telegram</small></li><li><a href={person.github}>Therad445</a><small>GitHub</small></li></ul><p>{pick(lang,'Если пишете о проекте, добавьте пару слов о задаче и ссылку на материалы. Так будет проще начать разговор.','If you’re writing about a project, include a few words about the task and a link to any relevant material. It gives us somewhere to start.')}</p></>}
</div>
</Layout>
