---
import {getCollection,render} from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import LogFlow from '../../../components/LogFlow.astro';
import ProjectEvidence from '../../../components/ProjectEvidence.astro';
import ResultsFigure from '../../../components/ResultsFigure.astro';
import {pick,url,type Lang} from '../../../data/site';
export async function getStaticPaths(){return (await getCollection('projects')).map(project=>({params:{lang:project.data.lang,slug:project.data.slug},props:{project}}))}
const {project}=Astro.props;
const lang=project.data.lang as Lang;
const {Content}=await render(project);
const title=project.data.noteTitle||project.data.title;
---
<Layout lang={lang} title={title} description={project.data.summary} path={`projects/${project.data.slug}`} type="Article" date={project.data.date}>
<header class="page-heading"><div class="breadcrumbs"><a href={url(lang,'projects')}>{pick(lang,'Все проекты','All projects')}</a></div><h1>{title}</h1><p class="article-date"><time datetime={project.data.date}>{new Date(project.data.date).toLocaleDateString(lang==='ru'?'ru-RU':'en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'})}</time> · {pick(lang,'Заметка о проекте','Project note')}</p></header>
{project.data.slug==='nginx-log-analyzer'&&<LogFlow lang={lang}/>}
{project.data.slug==='nstep-sac-reproducibility'&&<ResultsFigure lang={lang}/>}
<article class="prose"><Content/></article>
{['nginx-log-analyzer','sre-observability-platform','cuda-rentsense-knn'].includes(project.data.slug)&&<ProjectEvidence lang={lang} slug={project.data.slug}/>}
<aside class="project-details" aria-label={pick(lang,'О проекте','Project details')}><p>{project.data.title} · {project.data.status}</p><p>{project.data.tags.join(' · ')}</p><div class="quiet-links"><a href={project.data.repo}>{pick(lang,'Исходный код','Source code')}</a><a href={`${project.data.repo}/blob/${project.data.branch}/README.md`}>README</a><a href={url(lang,'projects')}>{pick(lang,'Другие проекты','Other projects')}</a></div></aside>
</Layout>
